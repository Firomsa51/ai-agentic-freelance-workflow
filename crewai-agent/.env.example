# ─────────────────────────────────────────────────
#  .env.example  –  copy to .env and fill in values
#  NEVER commit your real .env file to version control
# ─────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────
# Set LLM_PROVIDER to "groq" or "gemini"
LLM_PROVIDER=groq

# Groq Cloud API key (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API key (free at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Dashboard Security ────────────────────────────
# Password to access the web dashboard
DASHBOARD_PASSWORD=change_me_strong_password

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=change_me_flask_secret_key

# ── Optional Job Search APIs ──────────────────────
# Adzuna (free tier: https://developer.adzuna.com)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ── Email Delivery (optional) ─────────────────────
# Uses Python smtplib — no paid services required.
# Gmail example: SMTP_SERVER=smtp.gmail.com, SMTP_PORT=587
#   Use an App Password (not your main password) if 2FA is on:
#   https://myaccount.google.com/apppasswords
# Outlook/Hotmail: SMTP_SERVER=smtp-mail.outlook.com, SMTP_PORT=587
# Port 465 uses SSL; port 587 uses STARTTLS (recommended)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_sender@gmail.com
SENDER_PASSWORD=your_app_password_here

# ── App Config ────────────────────────────────────
PORT=8080
FLASK_ENV=production
